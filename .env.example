# Required. Local development: copy to .env.local (gitignored). Builds: set them per environment in EAS (eas env:create).
# Backend API (production: https)
EXPO_PUBLIC_BACKEND_URL=https://api.example.com/api
# WorkOS client id of the matching WorkOS environment (staging / production)
EXPO_PUBLIC_WORKOS_CLIENT_ID=
# One of the backend's API_CLIENT_KEYS (X-App-Key header). Any non-empty value works against a local backend without keys.
EXPO_PUBLIC_APP_KEY=

# Optional
# Public web pages (privacy policy, account deletion). Defaults to BACKEND_URL without /api.
EXPO_PUBLIC_WEB_URL=
# Support address (Settings, member reports). Defaults to the developer's address.
EXPO_PUBLIC_SUPPORT_EMAIL=
